# Les Odacieuses — Cockpit servi en fichiers statiques (hébergement OVH, Apache)
Options -MultiViews -Indexes
DirectoryIndex _shell.html

# Fichiers techniques jamais servis (dossier .git créé par le déploiement OVH, README du dépôt)
RedirectMatch 404 /\.git
RedirectMatch 404 ^/README\.md$
RewriteEngine On
RewriteBase /

# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Toutes les adresses de l'application renvoient vers la coquille SPA
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ _shell.html [L]

<IfModule mod_headers.c>
  # Phase de test : ne pas indexer l'application
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
